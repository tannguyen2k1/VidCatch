{
    "manifest_version": 3,
    "name": "Video Downloader Pro",
    "version": "1.0.0",
    "description": "Download videos from any website - works like IDM. Detect and download videos easily.",
    "permissions": [
        "downloads",
        "storage",
        "activeTab",
        "webRequest"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background/background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup/index.html",
        "default_title": "Video Downloader Pro",
        "default_icon": {
            "16": "icons/icon16-gray.png",
            "48": "icons/icon48-gray.png",
            "128": "icons/icon128-gray.png"
        }
    },
    "icons": {
        "16": "icons/icon16-gray.png",
        "48": "icons/icon48-gray.png",
        "128": "icons/icon128-gray.png"
    },
    "options_page": "options/index.html"
}
